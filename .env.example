# Copy to .env (git-ignored) and fill in. Real environment variables override this file.

# --- Optional LLM query understanding -------------------------------------
# The app works fully without these; when disabled or unavailable it uses the
# rule-based query understanding.
LLM_ENABLED=false
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Default: gemini-3.1-flash-lite (fast, low-cost; built for simple extraction)
GEMINI_MODEL=gemini-3.1-flash-lite
LLM_TIMEOUT_SECONDS=5

# Only used to estimate cost in scripts/compare_llm.py (USD per 1M tokens).
LLM_INPUT_PRICE_PER_M=0.25
LLM_OUTPUT_PRICE_PER_M=1.50
